{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "BackgroundJobs": {
    "Enabled": true
  },
  "Ai": {
    "Mode": "None"
  },
  "Email": {
    "Mode": "None"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "AllowedHosts": "*"
}
